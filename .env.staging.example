# Parent email notifications — copy values to the managed staging secret store.
# Keep disabled until provider, verified recipients, SPF, DKIM, and DMARC are ready.
EMAIL_NOTIFICATIONS_ENABLED=false
EMAIL_TRANSPORT=smtp
# Every automatic trigger defaults to disabled. Enable only reviewed events.
EMAIL_HOMEWORK_NOTIFICATIONS_ENABLED=false
EMAIL_ATTENDANCE_NOTIFICATIONS_ENABLED=false
EMAIL_RESULTS_NOTIFICATIONS_ENABLED=false
EMAIL_CIRCULAR_NOTIFICATIONS_ENABLED=false
EMAIL_EVENT_NOTIFICATIONS_ENABLED=false
# Local/staging safety mode narrows eligible recipients to per-event lists.
# An empty allowlist sends to nobody; it never means "all recipients".
EMAIL_AUTOMATION_TEST_MODE=true
EMAIL_HOMEWORK_TEST_RECIPIENTS=
EMAIL_ATTENDANCE_TEST_RECIPIENTS=
EMAIL_RESULTS_TEST_RECIPIENTS=
EMAIL_CIRCULAR_TEST_RECIPIENTS=
EMAIL_EVENT_TEST_RECIPIENTS=
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=replace-with-managed-secret
SMTP_FROM_EMAIL=no-reply@your-sender-domain
SMTP_FROM_NAME=Rosary School
SMTP_MESSAGE_ID_DOMAIN=your-sender-domain
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_BATCH_SIZE=50
EMAIL_RATE_LIMIT_PER_SECOND=5
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_SECONDS=60
EMAIL_WORKER_POLL_SECONDS=10
EMAIL_PROCESSING_TIMEOUT_SECONDS=900
EMAIL_FEE_REMINDERS_ENABLED=false
SCHOOL_PORTAL_URL=https://rosary-frontend.vercel.app
PUBLIC_API_URL=https://api.example.com
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# Login brute-force protection (per API process; also rate-limit at nginx).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_MAX_FAILED_ATTEMPTS_PER_IP=25
LOGIN_ATTEMPT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_SECONDS=900
